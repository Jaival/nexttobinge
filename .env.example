# Copy to .env.local and fill in. Never commit the copy: it holds secrets.
# Validated at startup by env.ts, so a missing required value fails fast.

# --- Required -------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=
DATABASE_URL=
TMDB_API_KEY=

# --- Optional -------------------------------------------------------------
# Public origin for canonical URLs, the sitemap and link previews.
SITE_URL=
# Search Console HTML-tag verification code (not needed with DNS verification).
GOOGLE_SITE_VERIFICATION=
# Sentry error monitoring. Off when empty.
NEXT_PUBLIC_SENTRY_DSN=
# Build-time only, for uploading source maps to Sentry. Set these in Vercel.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
